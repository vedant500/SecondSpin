<body>
    <div class="container mt-4">
        <h2 class="text-center mb-4">My Profile</h2>
    
        <!-- User Profile Card -->
        <div class="card shadow-sm p-4 mb-4">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <img src="https://ui-avatars.com/api/?name=<%= currUser.username %>&background=random&size=100" 
                         alt="Profile Picture" class="rounded-circle">
                </div>
                <div>
                    <h4><%= currUser.username %></h4>
                    <p class="text-muted"><strong>Email:</strong> <%= currUser.email %></p>
                </div>
            </div>
        </div>
    
        <h3 class="mb-3">My Listings</h3>
    
        <div class="row">
            <% if (listings.length > 0) { %>
                <% listings.forEach(listing => { %>
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            <% if (listing.image) { %>
                                <img src="<%= listing.image.url %>" class="card-img-top" alt="Listing Image">
                            <% } %>
                            <div class="card-body">
                                <h5 class="card-title"><%= listing.title %></h5>
                                <% if (listing.price) { %>
                                    <p class="text-muted">&#8377;<%= listing.price %>/-</p>
                                <% } %>
                                <a href="/listings/<%= listing._id %>" class="btn btn-primary">View Listing</a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <p class="text-muted">You haven't created any listings yet.</p>
            <% } %>
        </div>
    </div>
</body>