                  <option value="PVPIT (Padmabhooshan Vasantdada Patil Institute of Technology)">PVPIT (Padmabhooshan Vasantdada Patil Institute of Technology)</option>
                  <option value="RMD Sinhgad School of Engineering">RMD Sinhgad School of Engineering</option>
                  <option value="Rajarambapu Institute of Technology">Rajarambapu Institute of Technology</option>
                  <option value="SCTR's Pune Institute of Computer Technology (PICT)">SCTR's Pune Institute of Computer Technology (PICT)</option>
