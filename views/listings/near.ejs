        </select>
        <div class="d-grid mt-3">
            <button type="submit" class="btn btn-primary">Find Listings</button>
        </div>
    </form>
</div>

<script>
    document.getElementById("collegeForm").addEventListener("submit", function (event) {
        const selectedCollege = document.getElementById("collegeSelect").value;
        if (!selectedCollege) {
            alert("Please select a college.");
            event.preventDefault(); // Prevent form submission
            return;
        }
        this.action = `/listings/near/${encodeURIComponent(selectedCollege)}`;
    });
</script>
