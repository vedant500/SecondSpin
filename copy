<style>
  .card {
  border: 1px solid #ddd !important; /* Light gray border */
  border-radius: 8px; /* Slightly rounded corners */
  transition: box-shadow 0.2s ease-in-out;
}

.card:hover {
  box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1); /* Subtle shadow on hover */
}

</style>

<body>
  <div class="container mb-5">
    <div class="row justify-content-center">
      <div class="ccol-12 col-sm-6 col-md-8 col-lg-12 col-xl-4">  
        <div class="card" >
          <img src="<%= listing.image %>" class="card-img-top" alt="">
          <hr>
          <div class="card-body">
            <h3 class="card-title text-center "><strong>Title:</strong><%= listing.title %></h3><br>
            <h5 class="ms-2"><strong>Price:</strong>&#8377;<%= listing.price %>/-</h5>
            <p class="card-text ms-2 "><strong>Description:</strong><%= listing.description %></p>
        
            <p class="ms-2"><strong>Contact:</strong> <%= listing.contact %></p>
            <p class="ms-2"><strong>College:</strong> <%= listing.collage %></p>

            <div class="d-flex justify-content-between mt-3 mb-3">
              <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE" class="w-50 ms-2 me-2">
                <button class="btn btn-danger  w-100">Delete</button>
              </form>

              <a href="/listings/<%= listing._id %>/edit" class="btn btn-success w-50 me-2 text-center">Edit</a>            </div>
          </div>
      </div>
      <br><br>
    </div>
    <hr>
    <br>
    <div>
      <h4>Leave a review</h4>
      <form action="/listings/<%=listing.id%>/reviews" method="post" novalidate class="needs-validation">
        <div>
          <label for="rating">Rating</label>
          <input class="mb-3" type="range" min="1" max="5" id="rating" name="review[rating]">
        </div>
        <div>
          <label for="comment">Comment</label>
          <textarea class="form-control " name="review[comment]" id="comment" cols="30" rows="3" required></textarea>
          <div class="invalid-feedback">Please Leave your comment</div>
        </div>
        <button class="btn btn-success mt-3">Submit</button>
      </form>
    </div>
    <% if (listing.reviews.length>0){ %>
      <div class="row ">
          <p><b>Ask Your Query About Product</b></p>
      <% for(review of listing.reviews){ %>
          <div class="card col-5 ms-3 mb-3">
              <div class="card-body">
                  <p class="card-text"> <%= review.comment %> </p>                
                    
                  </p>
              </div>
              <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mb-3">
                  <Button class="btn btn-sm btn-dark">Delete</Button></form>
                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>/reply">
                  <textarea name="reply[comment]" class="form-control mb-2" placeholder="Write a reply..." required></textarea>
                  <button type="submit" class="btn btn-sm btn-primary">Send</button>
                </form>

                 <!-- Display Replies -->
        <% if (review.replies.length > 0) { %>
          <div class="mt-2">
            <strong>Replies:</strong>
            <ul class="list-unstyled">
              <% for (let reply of review.replies) { %>
                <li class="border p-2 mt-1"><%= reply.comment %></li>
              <% } %>
            </ul>
          </div>
        <% } %>
                  
          </div>
      <% } %>
  </div>
  <% } %>
  </div>
  </div>
</body>
</html> 





<style>
  /* Base styles */
  .navbar {
    padding: 0.25rem 0.5rem;
  }
  
  .btn-search {
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0.3rem 0.8rem;
    font-size: 0.85rem;
    white-space: nowrap;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .search-input {
    border-radius: 25px;
    padding: 0.3rem 0.8rem;
    font-size: 0.85rem;
  }

  /* Logo sizing */
  .navbar-brand img {
    width: 36px;
    height: 36px;
    margin-right: 0.5rem;
  }

  /* Search container - takes 60% width and centers */
  .search-container {
    width: 60%;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  /* Navbar layout - ensures all elements stay in one line */
  .navbar-container {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    width: 100%;
    position: relative; /* Needed for absolute positioning of search */
  }

  /* Space for logo and toggler */
  .navbar-sides {
    flex: 1;
    display: flex;
    justify-content: space-between;
    min-width: 80px; /* Ensures logo and toggler stay visible */
  }

  /* Dropdown menu */
  .custom-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    width: 100%;
    background: white;
    z-index: 1050;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    border-radius: 0 0 10px 10px;
    padding: 15px;
    max-height: 400px;
    overflow-y: auto;
  }

  /* Medium devices (tablets, 768px and up) */
  @media (min-width: 768px) {
    .navbar {
      padding: 0.5rem 1rem;
    }
    
    .btn-search {
      padding: 0.4rem 1.5rem;
      font-size: 1rem;
    }
    
    .search-input {
      padding: 0.4rem 1.5rem;
      font-size: 1rem;
    }
    
    .navbar-brand img {
      width: 50px;
      height: 50px;
    }
    
    .custom-dropdown {
      width: 280px;
      right: 10px;
      border-radius: 10px;
    }
    
    .search-container {
      width: 50%; /* Slightly wider on tablets */
    }
  }

  /* Large devices (desktops, 992px and up) */
  @media (min-width: 992px) {
    .search-container {
      width: 40%; /* Narrower on desktops */
    }
    .search-input {
      padding: 0.4rem 2rem;
    }
  }
</style>

